# SPDX-License-Identifier: BSL-1.0
# Standalone execution documentation; configured by cpp-library.
# [DEPENDENCY] https://github.com/doxygen/doxygen/releases
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_BRIEF          = "@PROJECT_BRIEF@"
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = "@OUTPUT_DIR@"
INPUT                  = "@INPUT_DIR@" "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen"
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = stlab::execution_detail stlab::execution_v*::execution_detail
GENERATE_LATEX         = NO
QUIET                  = YES
# Inherited APIs contain undocumented internals; broken references still fail.
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = YES
EXAMPLE_PATH           = "@EXAMPLES_PATH@"
# [DEPENDENCY] https://github.com/jothepro/doxygen-awesome-css/releases
HTML_EXTRA_STYLESHEET  = "@AWESOME_CSS_PATH@/doxygen-awesome.css" \
                         "@AWESOME_CSS_PATH@/doxygen-awesome-sidebar-only.css" \
                         "@CPP_LIBRARY_ROOT@/templates/custom.css"
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW       = YES
DISTRIBUTE_GROUP_DOC   = YES
MAX_INITIALIZER_LINES  = 0
MULTILINE_CPP_IS_BRIEF  = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DIRECTORY_GRAPH        = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
USE_MATHJAX            = YES
# [DEPENDENCY] https://github.com/mathjax/MathJax/releases
MATHJAX_VERSION        = MathJax_4
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@4.1.3
INCLUDE_PATH           = "@CMAKE_CURRENT_BINARY_DIR@/include"
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = STLAB_EXECUTION_VERSION_NAMESPACE_BEGIN()= \
                        STLAB_EXECUTION_VERSION_NAMESPACE_END()= \
                        STLAB_CORE_API= \
                        STLAB_NODISCARD()=[[nodiscard]]
HIDE_FRIEND_COMPOUNDS  = YES
